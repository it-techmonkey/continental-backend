# Server configuration
PORT=3500
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# Auth
JWT_SECRET="generate-a-strong-random-string-at-least-32-characters"
JWT_EXPIRES_IN=7d

# CORS (comma-separated origins, leave empty for same-origin only)
CORS_ORIGINS=

# Cloudflare R2 storage (required if using upload endpoints)
# Account ID is in the Cloudflare dashboard URL / R2 overview page.
R2_ACCOUNT_ID=
# Create an R2 API token with "Object Read & Write" scoped to the bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public read URL for the bucket, no trailing slash. Either the r2.dev
# subdomain (enable Public Access on the bucket) or a bound custom domain.
# e.g. https://pub-xxxxxxxx.r2.dev  or  https://cdn.yourdomain.com
R2_PUBLIC_URL=
